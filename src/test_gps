import time
import quecgnss
import atcmd
from misc import Power

from usr import xtra


TEMPS_MAXIM_FIX = 120

PROVES_SENSE_XTRA = 5
PROVES_AMB_XTRA = 10

ARXIU_ESTAT = "/usr/test_antena_estat.txt"
ARXIU_RESULTATS = "/usr/test_antena.csv"


def enviar_at(comanda, espera=5):
    resposta = bytearray(300)

    ret = atcmd.sendSync(
        comanda + "\r\n",
        resposta,
        "",
        espera
    )

    text = bytes(resposta).decode("utf-8", "ignore")

    return ret, text


def carregar_estat():
    try:
        with open(ARXIU_ESTAT, "r") as f:
            return int(f.read())
    except:
        return 0


def desar_estat(prova):
    with open(ARXIU_ESTAT, "w") as f:
        f.write(str(prova))


def guardar_resultat(prova, mode, temps_fix, sat, error=""):
    try:
        with open(ARXIU_RESULTATS, "r"):
            existeix = True
    except:
        existeix = False

    with open(ARXIU_RESULTATS, "a") as f:

        if not existeix:
            f.write("prova,mode,temps_fix,sat,error\n")

        f.write(
            "{},{},{},{},{}\n".format(
                prova,
                mode,
                temps_fix,
                sat,
                error
            )
        )


def obtenir_fix_i_sats(dades):
    # Protecció: 'dades' pot arribar com bytes segons el buffer intern
    if isinstance(dades, bytes):
        dades = dades.decode("utf-8", "ignore")

    for linia in dades.split("\n"):

        if "$GPGGA" in linia:
            camps = linia.split(",")

            if len(camps) > 7:
                try:
                    qualitat = int(camps[6])
                    sat = int(camps[7]) if camps[7] else 0

                    if qualitat > 0:
                        return True, sat

                except:
                    pass

    return False, 0


# --------------------------------------------------

time.sleep(5)
prova = carregar_estat()

total = PROVES_SENSE_XTRA + PROVES_AMB_XTRA

if prova >= total:
    print("===== TEST ACABAT =====")
    print("Resultats:", ARXIU_RESULTATS)

    while True:
        time.sleep(60)


if prova < PROVES_SENSE_XTRA:
    mode = "sense_xtra"
else:
    mode = "amb_xtra"


print()
print("===== TEST ANTENA GPS =====")
print("Prova:", prova + 1, "/", total)
print("Mode:", mode)


# Inicialitzar GNSS

quecgnss.setPriority(0)

error_init = None

if quecgnss.init() != 0:
    error_init = "error_init_gnss"
    print("ERROR inicialitzant GNSS")
else:
    quecgnss.gnssEnable(0)


if error_init:
    # No té sentit continuar aquest cicle: es guarda com a error
    # i es passa al seguent per no bloquejar tot el test
    guardar_resultat(prova + 1, mode, 0, 0, error_init)
    desar_estat(prova + 1)
    print("Resultat desat (amb error)")
    print("Reiniciant...")
    time.sleep(3)
    Power.powerRestart()


# Esborrar dades GNSS anteriors

ret, text = enviar_at("AT+QGPSDEL=0")

print("QGPSDEL:", ret)


# XTRA només a la segona sèrie

if mode == "amb_xtra":

    hores = xtra.obtenir_hores_restants()

    print("XTRA hores:", hores)

    if hores is None or hores < 12:
        print("Descarregant XTRA...")

        if xtra.descarregar():
            print("XTRA descarregat")
            print("Esperant que la radio cel·lular quedi lliure...")
            time.sleep(10)
        else:
            print("ERROR descarregant XTRA")


time.sleep(1)


# Iniciar GNSS i cronòmetre

quecgnss.gnssEnable(1)

inici = time.ticks_ms()

fix = False
sat = 0
error_lectura = ""

while time.ticks_diff(time.ticks_ms(), inici) < TEMPS_MAXIM_FIX * 1000:

    try:
        resultat = quecgnss.read(4096)

        if resultat != -1 and resultat[0] > 0:
            fix, sat = obtenir_fix_i_sats(resultat[1])

            if fix:
                break

    except Exception as e:
        error_lectura = "error_lectura:{}".format(e)
        print("Error llegint GNSS:", e)
        # No trenquem el bucle: es reintenta al seguent cicle de lectura

    time.sleep(1)


if fix:

    temps_fix = time.ticks_diff(
        time.ticks_ms(),
        inici
    ) // 1000

    print("FIX:", temps_fix, "s")
    print("SAT:", sat)

else:

    temps_fix = TEMPS_MAXIM_FIX

    print("SENSE FIX després de", TEMPS_MAXIM_FIX, "s")


# Guardar resultat

guardar_resultat(
    prova + 1,
    mode,
    temps_fix,
    sat,
    error_lectura
)


# Preparar següent prova

desar_estat(prova + 1)

print("Resultat desat")
print("Reiniciant...")

time.sleep(3)

Power.powerRestart()
